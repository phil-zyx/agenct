# Agenct v2 Configuration. Only the LLM key is needed to get started.
AGENCT_BIND=0.0.0.0:8080
AGENCT_DATA_DIR=/data
# Default: http://localhost:8080. Set your real URL when exposing the Hub (HTTPS required
# for non-localhost origins unless AGENCT_ALLOW_HTTP_ORIGIN=1).
# AGENCT_PUBLIC_ORIGIN=https://agenct.example.com
AGENCT_SESSION_TTL_SECONDS=28800

# --- Login ---------------------------------------------------------------------------
# Without GitLab, Agenct runs in single-owner mode: a login token is printed in the logs on
# first start and saved to <data dir>/login-token. Lost it? Stop the Hub and run
# `agenct-hub reset-login-token`. Optionally pin your own token:
# AGENCT_LOGIN_TOKEN=at-least-16-characters

# Optional GitLab OAuth team login (enables multi-user + colleague delegation):
# AGENCT_GITLAB_URL=https://git.example.com
# AGENCT_GITLAB_CLIENT_ID=replace-with-client-id
# AGENCT_GITLAB_CLIENT_SECRET=replace-with-client-secret
# AGENCT_GITLAB_CALLBACK_PATH=/auth/callback
# AGENCT_ADMINS=your-gitlab-username
# Keep the local owner login enabled alongside GitLab:
# AGENCT_LOCAL_LOGIN=1

# OpenAI-compatible LLM (DeepSeek / OpenAI / Ollama)
AGENCT_LLM_URL=https://api.deepseek.com/v1/chat/completions
AGENCT_LLM_API_KEY=replace-with-llm-api-key
AGENCT_LLM_MODEL=deepseek-chat
# Set to 1 only if the default model above accepts image input (e.g. gpt-4o, qwen-vl-max).
# AGENCT_LLM_SUPPORTS_IMAGES=1

# Optional default image-captioning model, used when the brain cannot see images.
# Each user can override both brain and vision models in 「设置 → 大脑模型」.
# AGENCT_VISION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# AGENCT_VISION_API_KEY=replace-with-vision-api-key
# AGENCT_VISION_MODEL=qwen-vl-plus

# User-configured model URLs must be public HTTPS; set this to allow intranet/HTTP endpoints
# (e.g. a LAN Ollama). Also relaxes the IM webhook allowlist.
# AGENCT_ALLOW_PRIVATE_OUTBOUND=1

# Optional: shared secret for workspace-wide GitLab webhooks
# AGENCT_GITLAB_WEBHOOK_SECRET=replace-with-random-secret

# Optional: AEAD (AES-256-GCM) encryption at rest for user model API keys, GitLab PATs, and IM
# webhooks (>= 32 chars, e.g. `openssl rand -hex 32`). Migrate existing plaintext or rotate keys
# while the Hub is stopped using: `agenct-hub reencrypt-secrets` (set AGENCT_MASTER_KEY_OLD when rotating).
# AGENCT_MASTER_KEY=replace-with-at-least-32-character-random-key
# AGENCT_MASTER_KEY_FILE=/run/secrets/agenct_master_key

# Local/intranet HTTP development only (disables Secure cookie requirement):
# AGENCT_ALLOW_HTTP_ORIGIN=1
