# Agenct v2 Configuration (single stack: GitLab OAuth + OpenAI-compatible LLM)
AGENCT_BIND=0.0.0.0:8080
AGENCT_DATA_DIR=/data
AGENCT_PUBLIC_ORIGIN=https://agenct.example.com

# GitLab OAuth 2.0 (only authentication plane)
AGENCT_GITLAB_URL=https://git.example.com
AGENCT_GITLAB_CLIENT_ID=replace-with-client-id
AGENCT_GITLAB_CLIENT_SECRET=replace-with-client-secret
AGENCT_GITLAB_CALLBACK_PATH=/auth/callback
AGENCT_SESSION_TTL_SECONDS=28800
AGENCT_ADMINS=your-gitlab-username

# OpenAI-compatible LLM (DeepSeek / OpenAI / Ollama)
AGENCT_LLM_URL=https://api.deepseek.com/v1/chat/completions
AGENCT_LLM_API_KEY=replace-with-llm-api-key
AGENCT_LLM_MODEL=deepseek-chat

# Optional: shared secret for workspace-wide GitLab webhooks
# AGENCT_GITLAB_WEBHOOK_SECRET=replace-with-random-secret

# Local/intranet HTTP development only (disables Secure cookie requirement):
# AGENCT_ALLOW_HTTP_ORIGIN=1
