# Copy to agenct.env (chmod 600). Never commit the real file.
AGENCT_PUBLIC_ORIGIN=http://10.0.0.11:5176
GITLAB_URL=https://git.example.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# 8 hours; allowed 300..86400.
AGENCT_SESSION_TTL_SECONDS=28800
# dsh = real DeepSeek (billable), mock = offline demo.
AGENCT_MODEL_RUNTIME=dsh
DEEPSEEK_API_KEY=
AGENCT_DSH_MODEL=deepseek-v4-flash
